# Mail indexer config. Copy to mail-index.toml (gitignored) and fill it in.
# See docs/email.md. Nothing is indexed until since and at least one account
# with mailboxes are set. Relative paths are relative to this file.

# Where mail comes from:
#   "script" (default)  asks Mail.app through scripting. Needs the Automation
#                       permission for Mail, not Full Disk Access. Mail opens
#                       if it isn't running.
#   "store"             reads Mail's files directly. Much faster on big
#                       mailboxes, but needs Full Disk Access and `store`.
#   "imap"              reads an IMAP server; see the example account below.
# An account can name its own source instead. Moving an account to another
# source re-indexes that account on the next run.
source = "script"

# Only with source = "store": the folder that holds Mail's V<n>/ directory,
# usually Library/Mail in your home folder. There is no default.
# store = ""

# Where the index is written. Keep it in the gitignored data tree.
index = "data/mail/index.sqlite"

# Only messages received on or after this date.
since = 2026-01-01

# Store message bodies (plain text, HTML converted to text) for search.
bodies = false
# Store attachment names, types and sizes. Attachment contents are never copied.
attachments = false
# Longest body kept per message, in characters.
max_body_chars = 100000

# Only with source = "script": seconds to wait for each call to Mail.
# script_timeout = 600

# One block per account. Get ids and mailbox names from:
#   python3 scripts/mail-index.py --config mail-index.toml mailboxes
# Mailboxes are exact names ("INBOX", "Projects/Alpha") or patterns: "*" is
# one level ("*" = every top-level mailbox, "Clients/*" = directly under
# Clients), "**" is any depth ("Clients/**"). Exact names are faster with the
# script source. Patterns skip Junk and Trash folders; name them to include.
[[accounts]]
id = "00000000-0000-0000-0000-000000000000"
mailboxes = ["INBOX"]

# An IMAP account (optional; any number, alongside Mail.app accounts). The id
# is your own name for it. Nothing on the server is changed. The password is
# never written here: add it to the Keychain with
#   macos/mail-apps/install.sh password work
# or, for terminal runs, name an environment variable in password_env.
# Proton: host = "127.0.0.1", port = 1143, security = "starttls" and tls_ca
# pointing at the certificate Proton Mail Bridge exports. See docs/email.md.
# [[accounts]]
# id = "work"
# source = "imap"
# host = "imap.example.com"
# port = 993
# security = "tls"
# user = "you@example.com"
# address = "you@example.com"
# mailboxes = ["INBOX"]
# password_env = "WORK_IMAP_PASSWORD"
