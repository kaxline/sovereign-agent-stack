{
  "manifestVersion": 1,
  "id": "io.example.split",
  "version": "1.0.0",
  "title": "Split Example",
  "tagline": "Synthetic add-on with one service per access level",
  "description": "Test fixture: ro and rw map to separate compose services.",
  "publisher": {
    "name": "example",
    "url": "https://example.com"
  },
  "minStackVersion": "0.3.12",
  "builtin": {
    "flag": "SPLIT_MCP_ENABLED",
    "profile": "split",
    "seed": false
  },
  "services": {
    "rw": {
      "compose": "split-rw",
      "port": 9000
    },
    "ro": {
      "compose": "split-ro",
      "port": 9000
    }
  },
  "mcp": {
    "service": {
      "ro": "ro",
      "rw": "rw"
    },
    "transport": "http",
    "path": "/mcp",
    "name": "split",
    "timeout": 60,
    "connectTimeout": 10,
    "tools": [
      "get_a",
      "get_b",
      "set_a"
    ],
    "pin": [
      "get_a",
      "set_a"
    ],
    "writeTools": [
      "set_a"
    ],
    "profiles": {
      "default": "rw",
      "browser": "rw",
      "api-server": "ro"
    },
    "env": {
      "access": "SPLIT_ACCESS"
    }
  },
  "permissions": {
    "reads": [],
    "writes": [],
    "egress": [],
    "cron": "ro"
  }
}
