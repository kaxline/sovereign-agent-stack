# =====================================================================
#  Run setup (recommended):   ./scripts/setup.sh
#  Or copy manually:         cp .env.example .env
# =====================================================================
#
#  NETWORKING NOTE (read this first):
#  These services run inside Docker. "localhost" inside a container means
#  the container itself, NOT your host. To reach a model server running on
#  the host, use  host.docker.internal  (already wired up in docker-compose.yml).
#  Example: a server at localhost:1234 on the host is reachable from containers
#  as  http://host.docker.internal:1234
#
#  The host server must listen beyond localhost:
#    - LM Studio: Developer tab -> enable "Serve on Local Network"
#    - Ollama:    OLLAMA_HOST=0.0.0.0
#    - llama.cpp / vLLM / etc.: bind 0.0.0.0 (or your LAN interface)
# =====================================================================


###########################
### Server
###########################
HOST=0.0.0.0
PORT=9621
# Active knowledge-base slug (alphanumeric + hyphens). Setup prompts for this.
# Storage: $ASSISTANT_DATA_ROOT/inputs/<WORKSPACE>/ and .../rag_storage/<WORKSPACE>/
# Only one corpus is hot at a time. Create/switch with:
#   make corpus-create SLUG=other && make corpus-use SLUG=other
# See docs/knowledge-bases.md. Do not set NEO4J_WORKSPACE / POSTGRES_WORKSPACE
# overrides — they collapse multi-corpus isolation.
WORKSPACE=my-kb

# User content root (projects, voice, memory, LightRAG inputs/storage, corpora).
# Hermes agent state stays at ./data/hermes. OpenCode uses OPENCODE_WORKSPACE_HOST.
# Change or move with:
#   make data-dir-show
#   make data-dir-set DIR=/path/to/assistant-data
#   make data-dir-migrate DIR=/path/to/assistant-data
# See docs/data-dir.md.
ASSISTANT_DATA_ROOT=./data
WEBUI_TITLE='My Knowledge Base'
WEBUI_DESCRIPTION='Local GraphRAG knowledge base'


###########################
### LLM  (chat + entity/relationship extraction)
###########################
# Point these at any OpenAI-compatible API (host LM Studio, llama.cpp, vLLM,
# a remote gateway, …) or use host/bundled Ollama below. Replace the
# your-* placeholders with model IDs your server actually serves.
# Also set the matching model id in opencode/opencode.local.json (setup
# points its baseURL at llm-proxy) and run Hermes bootstrap so profiles
# use the proxy. These host and key values are read only by llm-proxy.
# Clients send the placeholder local-llm. Native Ollama (no /v1) is not
# routed through the proxy; setup --ollama sets LIGHTRAG_LLM_CLIENT_HOST
# and EMBEDDING_CLIENT_HOST so LightRAG talks to Ollama directly.
#
# ---- Host OpenAI-compatible API ------------------------------------
LLM_BINDING=openai
LLM_MODEL=your-chat-model
LLM_BINDING_HOST=http://host.docker.internal:1234/v1
LLM_BINDING_API_KEY=local-llm          # any non-empty string for most local servers

# LightRAG can use a separate (often smaller) model for ingestion / KG extraction.
LIGHTRAG_LLM_BINDING=openai
LIGHTRAG_LLM_MODEL=your-extraction-model
LIGHTRAG_LLM_BINDING_HOST=http://host.docker.internal:1234/v1
LIGHTRAG_LLM_BINDING_API_KEY=local-llm

# ---- Host Ollama (comment out the OpenAI-compatible block above) ---
# LLM_BINDING=ollama
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_BINDING_HOST=http://host.docker.internal:11434   # NOTE: no /v1 for ollama
# LLM_BINDING_API_KEY=
#
# Or use the bundled demo: ./scripts/setup.sh --ollama (rewrites these for you).

# Loopback admin API. A POST replaces the in-memory upstreams; a restart
# loads the values above again. setup.sh fills a blank or change-me token.
LLM_PROXY_ADMIN_PORT=4001
LLM_PROXY_ADMIN_TOKEN=change-me
# Routes that answer 503 until an admin POST names them, for an app that
# starts the proxy keyless and pushes keys (docs/extending.md). Empty: off.
# LLM_PROXY_AWAIT_PUSH=chat,lightrag

# Local models are slow and shouldn't be hammered with parallel calls.
LLM_TIMEOUT=600
# llm-proxy only: the longest silent gap once a reply has started streaming.
# The proxy then drops the connection so the client sees a dead stream.
# Empty = LLM_TIMEOUT. LLM_TIMEOUT still bounds the wait for the first byte
# (prompt prefill).
# LLM_STREAM_IDLE_TIMEOUT=120
MAX_ASYNC=1
OPENAI_LLM_MAX_TOKENS=9000


###########################
### Embeddings
###########################
# IMPORTANT: EMBEDDING_DIM must match your embedding model exactly, or
# indexing will produce a corrupt store.
#   nomic-embed-text v1.5 -> 768
#   bge-m3                -> 1024
#   text-embedding-3-small-> 1536
#
# Tip: on machines that load one model at a time, run embeddings on a separate
# server from chat (e.g. Ollama for embeddings + another host server for chat)
# so GraphRAG indexing does not thrash model loads. Example:
#
#   EMBEDDING_BINDING=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIM=768
#   EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
#
# ---- Same OpenAI-compatible server as chat (simplest) --------------
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIM=768
EMBEDDING_BINDING_HOST=http://host.docker.internal:1234/v1
EMBEDDING_BINDING_API_KEY=local-llm


###########################
### Graph store: Neo4j
###########################
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
NEO4J_URI=bolt://neo4j:7687            # 'neo4j' = the compose service name
NEO4J_USERNAME=neo4j                  # Neo4j requires the admin user to be 'neo4j'
NEO4J_PASSWORD=change-me-please       # >= 8 chars; also used by the healthcheck

# KV / vector / doc-status stay file-based (in ./data/rag_storage) by default,
# which keeps the stack light. Only the graph lives in Neo4j.
# LIGHTRAG_KV_STORAGE=JsonKVStorage
# LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
# LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage


###########################
### LightRAG API auth (required for n8n workflows)
###########################
LIGHTRAG_API_KEY=change-me-lightrag-api-key
WHITELIST_PATHS=/health,/api/*

# LightRAG MCP sidecar for Hermes Knowledge Base access.
LIGHTRAG_MCP_PORT=8000
LIGHTRAG_MCP_PATH=/mcp
LIGHTRAG_MCP_URL=http://lightrag-mcp:8000/mcp
LIGHTRAG_MCP_TIMEOUT=120
LIGHTRAG_MCP_CONNECT_TIMEOUT=30


###########################
### n8n (Postgres-backed; mirrors self-hosted-ai-starter-kit defaults)
###########################
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=n8n-local-dev-key-change-me
N8N_USER_MANAGEMENT_JWT_SECRET=n8n-local-jwt-secret-change-me
N8N_DEFAULT_BINARY_DATA_MODE=filesystem


###########################
### OpenCode (AI coding agent)
###########################
OPENCODE_PORT=4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me-please
# Host directory exposed to OpenCode, mounted at this same path in the container
# so paths in the UI match paths in your terminal. Must be absolute, not /, and
# must not end in a slash. Every git repo underneath becomes its own project.
# A parent folder exposes every project's .env to the agent — shadow them via
# docker-compose.override.yml (see docs/opencode.md).
OPENCODE_WORKSPACE_HOST=/Users/you/code
# Extra coding roots (colon-prefixed absolute paths), managed by:
#   make coding-root-add DIR=/absolute/path
# Also mirrored as bind mounts on the terminal backend (hermes-worker, or hermes
# when HERMES_TERMINAL_BACKEND=local) and opencode in docker-compose.override.yml.
CODING_EXTRA_ROOTS=
# Extra Hermes-only read-only mounts for project file context (notes vaults).
# Not on HERMES_WRITE_SAFE_ROOT and not mounted into OpenCode. They bind on the
# terminal backend (hermes-worker, or hermes when HERMES_TERMINAL_BACKEND=local).
# Managed by:
#   make context-root-add DIR=/absolute/path
# Declare the same path in the project's sources.yaml, then make project-index.
# See docs/projects.md. Do not mount $HOME.
CONTEXT_EXTRA_ROOTS=
# When coding profile is enabled, setup sets OPENCODE_MCP_ENABLED=1 so Hermes
# registers coding_* tools (default + browser profiles only — not api-server).
OPENCODE_MCP_ENABLED=0
OPENCODE_MCP_URL=http://opencode-mcp:8000/sse
OPENCODE_MCP_TIMEOUT=600
OPENCODE_MCP_CONNECT_TIMEOUT=30
OPENCODE_MCP_TASK_TIMEOUT=600


###########################
### Compose profiles
###########################
# Default after setup: core (Hermes agent + WebUI + SearXNG).
# Combine with commas, e.g. core,rag,automation,coding
#
#   core         Hermes + Hermes WebUI + SearXNG + mcp-searxng
#   rag          LightRAG + Neo4j + lightrag-mcp
#   calendar     caldav-mcp (Hermes calendar; accounts under compose/caldav-mcp/accounts/)
#   automation   n8n + Postgres + GPT Researcher + gptr-mcp
#   coding       OpenCode + opencode-mcp (Hermes coding_* delegation)
#   ollama       Bundled Ollama (zero-config demo; prefer a host GPU server for speed)
#   searxng-prod Valkey + rate limiting for SearXNG
#   signal       signal-cli HTTP daemon (toggled by HERMES_SIGNAL_ENABLED; do not
#                edit this profile by hand — run make ensure-local / setup)
#
COMPOSE_PROFILES=core

# When rag is enabled, setup sets LIGHTRAG_MCP_ENABLED=1 so Hermes registers
# the read-only LightRAG MCP tools. Leave 0 on core-only to avoid connect timeouts.
LIGHTRAG_MCP_ENABLED=0

# When calendar is enabled, setup sets CALDAV_MCP_ENABLED=1 so Hermes registers
# each compose/caldav-mcp/accounts/<slug>.env as mcp_servers.caldav-<slug>.
# Multi-account: add more *.env files, then re-run hermes-*-bootstrap. See docs/calendar.md.
CALDAV_MCP_ENABLED=0

# Signal messaging for Hermes (optional). Set HERMES_SIGNAL_ENABLED=1 after linking
# signal-cli on the host, then run `make ensure-local` (or setup) so the `signal`
# profile is synced into COMPOSE_PROFILES and data/hermes/.env is seeded.
# See docs/signal.md.
HERMES_SIGNAL_ENABLED=0
# SIGNAL_ACCOUNT=+15551234567
# SIGNAL_ALLOWED_USERS=+15551234567
# SIGNAL_HOME_CHANNEL=+15551234567   # Note to Self; default WebUI send + cron delivery target
# Host path to the linked signal-cli store (default set by sync script):
# SIGNAL_CLI_DATA_DIR=/Users/you/.local/share/signal-cli
# Optional: match the UID/GID that owns SIGNAL_CLI_DATA_DIR (defaults to HERMES_UID/GID)
# SIGNAL_CLI_UID=1000
# SIGNAL_CLI_GID=1000

# Buzz messaging for Hermes (optional; path-③ native gateway). No compose sidecar —
# Hermes talks to your community relay over HTTPS/WSS. Independent agents live under
# data/hermes/profiles/<name>/ (gitignored). See docs/agents.md.
#
# Local quick path:
#   make bootstrap-buzz
#   make agent-create NAME=software-engineer DISPLAY_NAME="Software Engineer" WITH=buzz
#   docker compose up -d --force-recreate hermes
#
# Hosted community: set BUZZ_RELAY_URL to your *.communities.buzz.xyz URL, create
# agents with agent-create … WITH=buzz, then invite the printed pubkey in Desktop.
# See docs/buzz.md and docs/agents.md.
HERMES_BUZZ_ENABLED=0
# Comma-separated existing Hermes profile names that should run Buzz (not browser/api-server):
# HERMES_BUZZ_PROFILES=software-engineer,ui-ux-designer
# Shared relay URL seeded into each listed profile's .env (private keys stay per-profile):
# BUZZ_RELAY_URL=https://mycommunity.communities.buzz.xyz
# Local Buzz checkout (make bootstrap-buzz defaults to ~/src/buzz when unset):
# BUZZ_LOCAL_DIR_PATH=~/src/buzz
# Local relay URL (match whatever `just relay` / Desktop Local Dev uses):
# BUZZ_RELAY_URL=ws://localhost:3000
# Channel agents auto-join (name or UUID; default general — open on Local Dev):
# BUZZ_DEFAULT_CHANNEL=general
# Optional human identity for private-channel add-member fallback (never commit):
# BUZZ_OPERATOR_PRIVATE_KEY=
# Optional Buzz Desktop deb pin for make buzz-cli-install (linux binary into data/hermes/.local/bin):
# BUZZ_CLI_VERSION=0.5.20
# Relay helpers (after bootstrap-buzz):
#   make buzz-relay-start|stop|status|logs
#   make buzz-admin generate-key
#   make buzz-admin -- add-member --pubkey npub1…

###########################
### Image pins
###########################
N8N_IMAGE=n8nio/n8n:1.107.4
NEO4J_IMAGE=neo4j:5.26-community
POSTGRES_IMAGE=postgres:16-alpine
SEARXNG_IMAGE=docker.io/searxng/searxng:2026.8.11-e8e710e42
MCP_SEARXNG_IMAGE=isokoliuk/mcp-searxng:1.15.0
CALDAV_MCP_IMAGE=ghcr.io/gelse/caldav-mcp:v0.1.0
GPTR_IMAGE=gptresearcher/gpt-researcher:0.8.1
OLLAMA_IMAGE=ollama/ollama:0.11.11
LIGHTRAG_IMAGE=ghcr.io/hkuds/lightrag:v1.4.9.3
# Native signal-cli daemon (jre variant; safer on Apple Silicon than native).
# Only pulled when the `signal` profile is active.
SIGNAL_CLI_IMAGE=registry.gitlab.com/packaging/signal-cli/signal-cli-jre:v0-14-7-2

###########################
### Hermes Agent (part of `core`)
###########################
# Image pins. Hermes WebUI reads the agent's state layout and imports agent
# modules directly, so the two are only tested against each other within a
# release window — bump these together, never one at a time.
#   agent tags:  https://hub.docker.com/r/nousresearch/hermes-agent/tags
#   webui tags:  https://github.com/nesquena/hermes-webui/releases
# The WebUI publishes two channels: `vX.Y.Z` (stable, roughly weekly) and
# `exp-vX.Y.Z` (prerelease, several per day). Track stable; the image tag drops
# the leading `v`. Do not use `latest` on either image.
HERMES_AGENT_IMAGE_TAG=v2026.9.14
HERMES_WEBUI_IMAGE_TAG=0.52.113

HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_UID=1000
HERMES_GID=1000
# ssh (default): shell and file tools run on hermes-worker, which has no secrets.
# local: escape hatch. Skip the worker and mount the workspace on hermes.
# After a change: make ensure-local, re-run both Hermes bootstraps, then
#   docker compose up -d --force-recreate --remove-orphans hermes
HERMES_TERMINAL_BACKEND=ssh
# IANA timezone for Hermes `date` and "Conversation started" (container TZ).
# Example: America/Los_Angeles. Compose defaults to UTC when unset.
# TZ=America/Los_Angeles
# Bound every Hermes LLM HTTP call (foreground + background review).
# Local endpoints skip implicit stale detection unless the stale value is set.
HERMES_API_TIMEOUT=180
HERMES_API_CALL_STALE_TIMEOUT=90
# Reconnects per failed stream (Hermes' own default is 2).
# HERMES_STREAM_RETRIES=1
# Seconds a streamed reply may go without a chunk before Hermes drops it.
# Hermes treats llm-proxy as local whatever is behind it, so bootstrap sizes
# this from LLM_BINDING_HOST: 300 for a local server, 180 for a cloud API.
# Re-run both Hermes bootstraps after changing it or LLM_BINDING_HOST.
# HERMES_PROXY_STALE_TIMEOUT=
# WebUI session titles. auto = off for a local upstream (the title call runs
# before your reply on a one-request server), on for a cloud one. 0/1 force it.
# HERMES_BROWSER_AUTO_TITLE=auto
# Dashboard basic auth. Required since agent 0.20.0: the dashboard binds
# 0.0.0.0 inside the container, which engages an auth gate that the old
# HERMES_DASHBOARD_INSECURE flag no longer opens. Without a provider the
# dashboard refuses to bind and the hermes healthcheck never passes.
# Generated by setup.sh; the host port stays bound to 127.0.0.1 regardless.
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=change-me-generate-with-openssl-rand-hex-16
HERMES_DASHBOARD_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# API server profile (automated by hermes-api-bootstrap; see compose/hermes/)
HERMES_API_PROFILE_NAME=api-server
HERMES_API_SERVER_PORT=8643
HERMES_API_MAX_TURNS=20
# Internal URL for n8n workflows on the compose network:
HERMES_API_URL=http://hermes:8643/v1
#
# API auth key lives in compose/hermes/api-server.env (not here):
#   cp compose/hermes/api-server.env.example compose/hermes/api-server.env
#   # set API_SERVER_KEY in that file
#
# If you previously enabled the API on the default profile via root .env, remove:
#   API_SERVER_ENABLED, API_SERVER_HOST, API_SERVER_KEY


###########################
### Hermes WebUI (part of `core`)
###########################
# Browser chat runs on its own `browser` Hermes profile so interactive use does
# not inherit the deliberately tight limits of the unattended `api-server`
# profile. Its gateway is internal only — the WebUI reaches it over the compose
# network, so HERMES_BROWSER_API_PORT is never published to the host.
HERMES_WEBUI_PORT=8787
HERMES_BROWSER_PROFILE_NAME=browser
HERMES_BROWSER_API_PORT=8644
HERMES_BROWSER_MAX_TURNS=60
#
# Browser auth key lives in compose/hermes/browser.env (not here):
#   cp compose/hermes/browser.env.example compose/hermes/browser.env
#   # set API_SERVER_KEY in that file (distinct from the api-server key)
#
# Project briefs (docs/projects.md): compose sets these on hermes-webui by default.
# Override only if you need a different script or a tighter budget for local models.
# HERMES_WEBUI_PREFILL_MESSAGES_SCRIPT=/bootstrap/project-brief-prefill.py
# HERMES_WEBUI_PREFILL_CONTEXT_MAX_CHARS=8000


###########################
### SearXNG (local meta-search)
###########################
SEARXNG_PORT=8080
# n8n/OpenCode use compose DNS names directly.
SEARXNG_URL=http://searxng:8080
# setup.sh writes the same value into searxng/settings.local.yml (gitignored)
SEARXNG_SECRET=change-me-to-a-long-random-string

###########################
### Bundled Ollama (opt-in; profile `ollama`)
###########################
# Enable with: ./scripts/setup.sh --ollama
# Then: docker compose run --rm ollama-pull
# On Apple Silicon, Docker cannot use the GPU — prefer a host model server
# for performance; this profile is the zero-config demo path.
OLLAMA_HOST_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text


###########################
### GPT Researcher (deep web research; SearXNG retriever)
###########################
GPTR_PORT=8000
GPTR_URL=http://gpt-researcher:8000          # n8n / Hermes REST calls
GPTR_MCP_URL=http://gptr-mcp:8000/sse        # OpenCode / Hermes MCP (SSE)

# GPT Researcher reads SEARX_URL (not SEARXNG_URL) for its retriever config.
RETRIEVER=searx
SEARX_URL=http://searxng:8080/
# GPT Researcher talks to llm-proxy. Compose sets OPENAI_API_KEY=local-llm
# and OPENAI_BASE_URL=http://llm-proxy:4000/v1. The real chat key is
# LLM_BINDING_API_KEY on the proxy. GPT Researcher has one base URL, so its
# embeddings use the chat route. LightRAG uses the /embed route.
# Compose derives FAST/SMART/STRATEGIC_LLM and EMBEDDING from LLM_MODEL and
# EMBEDDING_MODEL; it does not read them from this file.

# Local-model tuning — critical when Hermes + LightRAG share one host server.
# Avoid running deep research while LightRAG is indexing or Hermes has active subagents.
GPTR_MAX_SCRAPER_WORKERS=2
GPTR_DEEP_RESEARCH_BREADTH=2
GPTR_DEEP_RESEARCH_DEPTH=1
GPTR_DEEP_RESEARCH_CONCURRENCY=1
GPTR_MAX_ITERATIONS=2



###########################
### SearXNG MCP sidecar (URL reading + search for Hermes)
###########################
# mcp-searxng exposes `web_url_read` (fetch a URL as markdown, no JS) alongside
# search. Registered on both Hermes profiles by the api-bootstrap container.
# Note: many publishers return 403 to this naive fetch; prefer search snippets
# or a working local browser when page bodies are blocked.
SEARXNG_MCP_URL=http://mcp-searxng:3000/mcp

###########################
### Running a second copy of the stack (see docs/extending.md)
###########################
# Container names and built image tags are global in Docker. A second copy
# needs its own project name, container prefix, image prefix and host ports.
# docker compose and every setup script read these from .env.
# COMPOSE_PROJECT_NAME=assistant
# CONTAINER_PREFIX=              # e.g. boundary- → boundary-hermes, boundary-llm-proxy
# IMAGE_PREFIX=assistant         # built images are ${IMAGE_PREFIX}-<service>:local
# NEO4J_HTTP_HOST_PORT=7474
# NEO4J_BOLT_HOST_PORT=7687
# N8N_HOST_PORT=5678
