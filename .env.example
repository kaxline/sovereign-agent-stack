# =====================================================================
#  Run setup (recommended):   ./scripts/setup.sh
#  Or copy manually:         cp .env.example .env
# =====================================================================
#
#  NETWORKING NOTE (read this first):
#  These services run inside Docker. "localhost" inside a container means
#  the container itself, NOT your Mac. To reach LM Studio / Ollama running
#  on your Mac, use the hostname  host.docker.internal  (already wired up
#  in docker-compose.yml). So an LM Studio server at localhost:1234 on your
#  Mac is reachable from the container as  http://host.docker.internal:1234
#
#  You must also make LM Studio / Ollama listen beyond localhost:
#    - LM Studio: Developer tab -> enable "Serve on Local Network"
#    - Ollama:    run with  OLLAMA_HOST=0.0.0.0  (so the app binds 0.0.0.0)
# =====================================================================


###########################
### Server
###########################
HOST=0.0.0.0
PORT=9621
# Knowledge-base slug (alphanumeric + hyphens). Setup prompts for this.
# Storage: data/inputs/<WORKSPACE>/ and data/rag_storage/<WORKSPACE>/
WORKSPACE=my-kb
WEBUI_TITLE='My Knowledge Base'
WEBUI_DESCRIPTION='Local GraphRAG knowledge base'


###########################
### LLM  (chat + entity/relationship extraction)
###########################
# ---- LM Studio (default) -------------------------------------------
LLM_BINDING=openai
LLM_MODEL=qwen/qwen3.5-35b-a3b
LLM_BINDING_HOST=http://host.docker.internal:1234/v1
LLM_BINDING_API_KEY=lm-studio          # any non-empty string works for LM Studio

# LightRAG currently uses a separate, smaller model optimized for ingestion
# and knowledge-graph extraction. Switch this to the stronger model when
# LightRAG query quality becomes the main focus.
LIGHTRAG_LLM_BINDING=openai
LIGHTRAG_LLM_MODEL=qwen/qwen3-vl-4b
LIGHTRAG_LLM_BINDING_HOST=http://host.docker.internal:1234/v1
LIGHTRAG_LLM_BINDING_API_KEY=lm-studio

# ---- Ollama alternative (comment out the LM Studio block above) -----
# LLM_BINDING=ollama
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_BINDING_HOST=http://host.docker.internal:11434   # NOTE: no /v1 for ollama
# LLM_BINDING_API_KEY=

# Local models are slow and shouldn't be hammered with parallel calls.
LLM_TIMEOUT=600
MAX_ASYNC=1
OPENAI_LLM_MAX_TOKENS=9000


###########################
### Embeddings
###########################
# IMPORTANT: EMBEDDING_DIM must match your embedding model exactly, or
# indexing will produce a corrupt store.
#   nomic-embed-text v1.5 -> 768
#   bge-m3                -> 1024
#   text-embedding-3-small-> 1536
#
# Recommendation on an M1: run the EMBEDDING model in Ollama even if your
# CHAT model is in LM Studio. LM Studio tends to hold one model per request
# path, and GraphRAG indexing interleaves thousands of chat + embedding
# calls. Splitting them avoids constant model eviction. Example:
#
#   EMBEDDING_BINDING=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIM=768
#   EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
#
# ---- LM Studio embeddings (simplest if you only want one server) ----
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b
# qwen3-embedding-8b returns 4096-dim vectors from LM Studio (not 1024).
EMBEDDING_DIM=4096
EMBEDDING_BINDING_HOST=http://host.docker.internal:1234/v1
EMBEDDING_BINDING_API_KEY=lm-studio


###########################
### Graph store: Neo4j
###########################
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
NEO4J_URI=bolt://neo4j:7687            # 'neo4j' = the compose service name
NEO4J_USERNAME=neo4j                  # Neo4j requires the admin user to be 'neo4j'
NEO4J_PASSWORD=change-me-please       # >= 8 chars; also used by the healthcheck

# KV / vector / doc-status stay file-based (in ./data/rag_storage) by default,
# which keeps the stack light. Only the graph lives in Neo4j.
# LIGHTRAG_KV_STORAGE=JsonKVStorage
# LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
# LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage


###########################
### LightRAG API auth (required for n8n workflows)
###########################
LIGHTRAG_API_KEY=change-me-lightrag-api-key
WHITELIST_PATHS=/health,/api/*

# LightRAG MCP sidecar for Hermes Knowledge Base access.
LIGHTRAG_MCP_PORT=8000
LIGHTRAG_MCP_PATH=/mcp
LIGHTRAG_MCP_URL=http://lightrag-mcp:8000/mcp
LIGHTRAG_MCP_TIMEOUT=120
LIGHTRAG_MCP_CONNECT_TIMEOUT=30


###########################
### n8n (Postgres-backed; mirrors self-hosted-ai-starter-kit defaults)
###########################
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=n8n-local-dev-key-change-me
N8N_USER_MANAGEMENT_JWT_SECRET=n8n-local-jwt-secret-change-me
N8N_DEFAULT_BINARY_DATA_MODE=filesystem


###########################
### OpenCode (AI coding agent)
###########################
OPENCODE_PORT=4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me-please
# Host directory exposed to OpenCode, mounted at this same path in the container
# so paths in the UI match paths in your terminal. Must be absolute, not /, and
# must not end in a slash. Every git repo underneath becomes its own project.
# A parent folder exposes every project's .env to the agent — shadow them via
# docker-compose.override.yml (see docs/opencode.md).
OPENCODE_WORKSPACE_HOST=/Users/you/code


###########################
### Compose profiles
###########################
# Default after setup: core (Hermes agent + WebUI + SearXNG).
# Combine with commas, e.g. core,rag,automation,coding
#
#   core         Hermes + Hermes WebUI + SearXNG + mcp-searxng
#   rag          LightRAG + Neo4j + lightrag-mcp
#   automation   n8n + Postgres + GPT Researcher + gptr-mcp
#   coding       OpenCode
#   ollama       Bundled Ollama (zero-config demo; prefer host LM Studio on Mac for speed)
#   crawl        Crawl4AI (JS-rendered URL reading)
#   mail         Proton Mail Bridge
#   searxng-prod Valkey + rate limiting for SearXNG
#
COMPOSE_PROFILES=core

# When rag is enabled, setup sets LIGHTRAG_MCP_ENABLED=1 so Hermes registers
# the read-only LightRAG MCP tools. Leave 0 on core-only to avoid connect timeouts.
LIGHTRAG_MCP_ENABLED=0

###########################
### Image pins
###########################
N8N_IMAGE=n8nio/n8n:1.107.4
NEO4J_IMAGE=neo4j:5.26-community
POSTGRES_IMAGE=postgres:16-alpine
SEARXNG_IMAGE=docker.io/searxng/searxng:2026.8.11-e8e710e42
MCP_SEARXNG_IMAGE=isokoliuk/mcp-searxng:1.15.0
GPTR_IMAGE=gptresearcher/gpt-researcher:0.8.1
OLLAMA_IMAGE=ollama/ollama:0.11.11
# LightRAG base used by compose/lightrag/Dockerfile (LM Studio json_schema patch)
LIGHTRAG_BASE_IMAGE=ghcr.io/hkuds/lightrag:v1.4.9.3

###########################
### Hermes Agent (part of `core`)
###########################
# Image pins. Hermes WebUI reads the agent's state layout and imports agent
# modules directly, so the two are only tested against each other within a
# release window — bump these together, never one at a time.
#   agent tags:  https://hub.docker.com/r/nousresearch/hermes-agent/tags
#   webui tags:  https://github.com/nesquena/hermes-webui/releases
# The WebUI publishes two channels: `vX.Y.Z` (stable, roughly weekly) and
# `exp-vX.Y.Z` (prerelease, several per day). Track stable; the image tag drops
# the leading `v`. Do not use `latest` on either image.
HERMES_AGENT_IMAGE_TAG=v2026.8.3
HERMES_WEBUI_IMAGE_TAG=0.52.106

HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_UID=1000
HERMES_GID=1000
# Dashboard basic auth. Required since agent 0.20.0: the dashboard binds
# 0.0.0.0 inside the container, which engages an auth gate that the old
# HERMES_DASHBOARD_INSECURE flag no longer opens. Without a provider the
# dashboard refuses to bind and the hermes healthcheck never passes.
# Generated by setup.sh; the host port stays bound to 127.0.0.1 regardless.
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=change-me-generate-with-openssl-rand-hex-16
HERMES_DASHBOARD_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# API server profile (automated by hermes-api-bootstrap; see compose/hermes/)
HERMES_API_PROFILE_NAME=api-server
HERMES_API_SERVER_PORT=8643
HERMES_API_MAX_TURNS=20
# Internal URL for n8n workflows on the compose network:
HERMES_API_URL=http://hermes:8643/v1
#
# API auth key lives in compose/hermes/api-server.env (not here):
#   cp compose/hermes/api-server.env.example compose/hermes/api-server.env
#   # set API_SERVER_KEY in that file
#
# If you previously enabled the API on the default profile via root .env, remove:
#   API_SERVER_ENABLED, API_SERVER_HOST, API_SERVER_KEY


###########################
### Hermes WebUI (part of `core`)
###########################
# Browser chat runs on its own `browser` Hermes profile so interactive use does
# not inherit the deliberately tight limits of the unattended `api-server`
# profile. Its gateway is internal only — the WebUI reaches it over the compose
# network, so HERMES_BROWSER_API_PORT is never published to the host.
HERMES_WEBUI_PORT=8787
HERMES_BROWSER_PROFILE_NAME=browser
HERMES_BROWSER_API_PORT=8644
HERMES_BROWSER_MAX_TURNS=60
#
# Browser auth key lives in compose/hermes/browser.env (not here):
#   cp compose/hermes/browser.env.example compose/hermes/browser.env
#   # set API_SERVER_KEY in that file (distinct from the api-server key)


###########################
### SearXNG (local meta-search)
###########################
SEARXNG_PORT=8080
# n8n/OpenCode use compose DNS names directly.
SEARXNG_URL=http://searxng:8080
# setup.sh writes the same value into searxng/settings.local.yml (gitignored)
SEARXNG_SECRET=change-me-to-a-long-random-string

###########################
### Bundled Ollama (opt-in; profile `ollama`)
###########################
# Enable with: ./scripts/setup.sh --ollama
# Then: docker compose run --rm ollama-pull
# On Apple Silicon, Docker cannot use the GPU — prefer host LM Studio / Ollama
# for performance; this profile is the zero-config demo path.
OLLAMA_HOST_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text


###########################
### GPT Researcher (deep web research; SearXNG retriever)
###########################
GPTR_PORT=8000
GPTR_URL=http://gpt-researcher:8000          # n8n / Hermes REST calls
GPTR_MCP_URL=http://gptr-mcp:8000/sse        # OpenCode / Hermes MCP (SSE)

# GPT Researcher reads SEARX_URL (not SEARXNG_URL) for its retriever config.
RETRIEVER=searx
SEARX_URL=http://searxng:8080/
OPENAI_API_KEY=lm-studio                     # any non-empty string; matches LLM_BINDING_API_KEY
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
FAST_LLM=openai:qwen/qwen3.5-35b-a3b
SMART_LLM=openai:qwen/qwen3.5-35b-a3b
STRATEGIC_LLM=openai:qwen/qwen3.5-35b-a3b
EMBEDDING=openai:text-embedding-qwen3-embedding-8b

# Local-model tuning — critical when Hermes + LightRAG share LM Studio.
# Avoid running deep research while LightRAG is indexing or Hermes has active subagents.
GPTR_MAX_SCRAPER_WORKERS=2
GPTR_DEEP_RESEARCH_BREADTH=2
GPTR_DEEP_RESEARCH_DEPTH=1
GPTR_DEEP_RESEARCH_CONCURRENCY=1
GPTR_MAX_ITERATIONS=2


###########################
### Crawl4AI (URL to markdown, JS-rendered; opt-in, off by default)
###########################
# Enable with: ./scripts/setup.sh --crawl   (adds `crawl` to COMPOSE_PROFILES)
# For pages that need a real browser. Static pages are cheaper to read with
# the mcp-searxng `web_url_read` tool, which is always on. See docs/crawl4ai.md.
CRAWL4AI_URL=http://crawl4ai:11235           # n8n / Hermes REST calls (POST /md)
CRAWL4AI_MCP_URL=http://crawl4ai:11235/mcp/sse   # OpenCode / Hermes MCP

# Required when the profile is on. Crawl4AI 0.9+ refuses to listen on anything
# but loopback without a token, and compose DNS needs a non-loopback bind.
# setup.sh --crawl generates one; `openssl rand -hex 32` by hand.
CRAWL4AI_API_TOKEN=

# Registers the Crawl4AI MCP server with Hermes. Set to 1 only when the profile
# is on — an unreachable MCP server costs a connect timeout on every session.
CRAWL4AI_MCP_ENABLED=0

# Pin a tag once a build is known good.
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.2


###########################
### SearXNG MCP sidecar (URL reading + search for Hermes)
###########################
# mcp-searxng exposes `web_url_read` (fetch a URL as markdown, no JS) alongside
# search. Registered on both Hermes profiles by the api-bootstrap container.
SEARXNG_MCP_URL=http://mcp-searxng:3000/mcp


###########################
### Proton Mail Bridge (opt-in; off by default)
###########################
# Requires a paid Proton plan. Quit the Mac Bridge app before starting the
# container — only one Bridge instance can run at a time.
#
# Enable with the rest of the stack — pick ONE approach:
#
#   A) In .env (no --profile on the CLI):
#        COMPOSE_PROFILES=mail
#      Or combine profiles:  COMPOSE_PROFILES=core,mail
#      Then:  docker compose up -d
#
#   B) Per command:
#        docker compose --profile mail up -d
#
# Setup (one-time interactive Proton login + 2FA):
#   ./scripts/setup.sh --mail
#   ./scripts/proton-bridge-init.sh
#
# n8n uses compose DNS: protonmail-bridge:143 (IMAP), protonmail-bridge:25 (SMTP).
# Bridge IMAP/SMTP credentials are auto-synced to n8n/demo-data/credentials/.
#
# COMPOSE_PROFILES=mail
#
# PROTON_BRIDGE_IMAGE is auto-set by setup.sh (--mail) from CPU arch:
#   arm64 -> shenxn/protonmail-bridge:build
#   amd64 -> shenxn/protonmail-bridge
PROTON_BRIDGE_IMAGE=
PROTON_BRIDGE_HOST=protonmail-bridge
PROTON_BRIDGE_IMAP_PORT=143
PROTON_BRIDGE_SMTP_PORT=25
PROTON_BRIDGE_IMAP_SECURE=false
PROTON_BRIDGE_ALLOW_UNAUTHORIZED_CERTS=true
