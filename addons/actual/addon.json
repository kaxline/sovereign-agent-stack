{
  "manifestVersion": 1,
  "id": "io.github.kaxline.stack.actual",
  "version": "1.0.0",
  "title": "Actual Budget",
  "tagline": "Read and edit an Actual Budget file from chat",
  "description": "Connects Hermes to Actual Budget files, one MCP entry per connected budget, served by actual-mcp-ro (read-only) and actual-mcp-rw (write). A budget is read-only on every profile until its bind gives the default and browser profiles rw (scripts/budget.sh access SLUG write); api-server and cron get only the read-only server. The budget is financial data. permissions.reads stays empty because the manifest's finance read class has not shipped. run-bank-sync is not exposed. See docs/budget.md.",
  "publisher": {
    "name": "sovereign-agent-stack",
    "url": "https://github.com/kaxline/sovereign-agent-stack"
  },
  "minStackVersion": "0.3.12",
  "builtin": {
    "flag": "ACTUAL_MCP_ENABLED",
    "profile": "budget",
    "seed": false
  },
  "services": {
    "rw": {
      "compose": "actual-mcp-rw",
      "port": 3000
    },
    "ro": {
      "compose": "actual-mcp-ro",
      "port": 3000
    },
    "server": {
      "compose": "actual-server",
      "port": 5006,
      "when": {
        "gate": "ACTUAL_LOCAL_ENABLED"
      }
    }
  },
  "mcp": {
    "instances": {
      "name": "budget-{slug}",
      "url": "http://actual-mcp-{access}:3000/{slug}/mcp"
    },
    "transport": "http",
    "timeout": 120,
    "connectTimeout": 60,
    "tools": [
      "get-transactions",
      "spending-by-category",
      "monthly-summary",
      "balance-history",
      "budget-vs-actual",
      "net-worth",
      "category-trends",
      "spending-by-payee",
      "cash-flow",
      "get-accounts",
      "get-grouped-categories",
      "get-payees",
      "get-rules",
      "get-custom-reports",
      "get-dashboards",
      "get-budget-months",
      "get-budget-month",
      "get-schedules",
      "add-dashboard-widget",
      "batch-update-transactions",
      "create-category",
      "create-category-group",
      "create-custom-report",
      "create-dashboard-page",
      "create-payee",
      "create-rule",
      "create-transaction",
      "delete-category",
      "delete-category-group",
      "delete-custom-report",
      "delete-dashboard-page",
      "delete-payee",
      "delete-rule",
      "delete-transaction",
      "hold-budget-for-next-month",
      "import-transactions",
      "merge-payees",
      "organize-dashboard",
      "remove-dashboard-widget",
      "rename-dashboard-page",
      "reset-budget-hold",
      "set-budget-amount",
      "set-budget-carryover",
      "update-category",
      "update-category-group",
      "update-custom-report",
      "update-dashboard-widget",
      "update-payee",
      "update-rule",
      "update-transaction"
    ],
    "pin": [
      "get-accounts",
      "get-grouped-categories",
      "get-transactions",
      "monthly-summary",
      "get-budget-month",
      "get-payees"
    ],
    "writeTools": [
      "add-dashboard-widget",
      "batch-update-transactions",
      "create-category",
      "create-category-group",
      "create-custom-report",
      "create-dashboard-page",
      "create-payee",
      "create-rule",
      "create-transaction",
      "delete-category",
      "delete-category-group",
      "delete-custom-report",
      "delete-dashboard-page",
      "delete-payee",
      "delete-rule",
      "delete-transaction",
      "hold-budget-for-next-month",
      "import-transactions",
      "merge-payees",
      "organize-dashboard",
      "remove-dashboard-widget",
      "rename-dashboard-page",
      "reset-budget-hold",
      "set-budget-amount",
      "set-budget-carryover",
      "update-category",
      "update-category-group",
      "update-custom-report",
      "update-dashboard-widget",
      "update-payee",
      "update-rule",
      "update-transaction"
    ],
    "profiles": {
      "default": "ro",
      "browser": "ro",
      "api-server": "ro"
    }
  },
  "permissions": {
    "reads": [],
    "writes": [
      "external:budget"
    ],
    "sends": false,
    "egress": [
      "internet"
    ],
    "exposesToAgent": false,
    "cron": "ro"
  },
  "gates": [
    {
      "flag": "ACTUAL_LOCAL_ENABLED",
      "profile": "budget-local",
      "seed": false
    }
  ],
  "settings": {
    "local": {
      "type": "bool",
      "default": false,
      "flag": "ACTUAL_LOCAL_ENABLED",
      "label": "Bundled local Actual server"
    }
  },
  "web": {
    "service": "server",
    "path": "/"
  },
  "hooks": {
    "init": {
      "script": [
        "scripts/budget.sh",
        "init",
        "--server-only"
      ]
    }
  },
  "data": {
    "paths": [
      {
        "env": "ACTUAL_DATA_DIR",
        "default": "./data/actual/server"
      }
    ],
    "volumes": [
      "actual_mcp_rw_cache",
      "actual_mcp_ro_cache"
    ]
  },
  "instances": {
    "name": "budget",
    "optional": true,
    "settings": {
      "server": {
        "type": "string",
        "label": "Actual server URL, or local for the bundled server"
      },
      "sync_id": {
        "type": "string",
        "label": "Budget sync ID"
      },
      "session_token": {
        "type": "secret",
        "optional": true,
        "label": "Session token"
      },
      "password": {
        "type": "secret",
        "optional": true,
        "transient": true,
        "label": "Server password (used once to sign in)"
      },
      "encryption_password": {
        "type": "secret",
        "optional": true,
        "label": "Budget encryption password"
      }
    },
    "connect": {
      "script": [
        "scripts/budget.sh",
        "connect"
      ]
    },
    "disconnect": {
      "script": [
        "scripts/budget.sh",
        "disconnect"
      ]
    },
    "errors": [
      "encryption_password"
    ]
  },
  "store": {
    "dataLeaves": "Budget data is read from and written to the Actual server each budget connects to. The bundled local server keeps it on this Mac."
  }
}
