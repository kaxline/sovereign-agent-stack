+class TestSessionOpen:
+    def test_resume_stamps_the_record_it_answers_with(self, live, monkeypatch):
+        monkeypatch.setattr(server, "_resume_session", lambda rid, params: {"result": {"session_id": "sid"}})
+
+        server._methods["session.resume"]("r", {"session_id": "stored", "context": "  Room: ops "})
+
+        assert live["client_context"] == "Room: ops"
+
+    def test_resume_without_the_field_keeps_it(self, live, monkeypatch):
+        live["client_context"] = "Room: ops"
+        monkeypatch.setattr(server, "_resume_session", lambda rid, params: {"result": {"session_id": "sid"}})
+
+        server._methods["session.resume"]("r", {"session_id": "stored"})
+
+        assert live["client_context"] == "Room: ops"
+
+    def test_resume_with_null_clears_it(self, live, monkeypatch):
+        live["client_context"] = "Room: ops"
+        monkeypatch.setattr(server, "_resume_session", lambda rid, params: {"result": {"session_id": "sid"}})
+
+        server._methods["session.resume"]("r", {"session_id": "stored", "context": None})
+
+        assert live["client_context"] is None
+
+    def test_invalid_context_refuses_before_anything_resumes(self, monkeypatch):
+        monkeypatch.setattr(server, "_resume_session", lambda rid, params: pytest.fail("must not resume"))
+
+        response = server._methods["session.resume"]("r", {"session_id": "stored", "context": 7})
+
+        assert _code(response) == cc.CONTEXT_INVALID
+
+    def test_create_refuses_invalid_context_before_minting_a_session(self, monkeypatch):
+        before = set(server._sessions)
+
+        response = server._methods["session.create"]("r", {"context": "x" * (cc.MAX_CONTEXT_CHARS + 1)})
+
+        assert _code(response) == cc.CONTEXT_INVALID
+        assert set(server._sessions) == before
+
