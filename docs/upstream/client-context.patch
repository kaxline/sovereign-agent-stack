+class TestPromptSubmitRefusals:
+    """Every refusal leaves the session as it was: no surface rewrite, no slot claim, no turn."""
+
+    def test_invalid_context(self, live):
+        response = _submit(context=["x"])
+
+        assert _code(response) == cc.CONTEXT_INVALID
+        assert "client_surface" not in live
+
+    def test_context_while_a_turn_runs(self, live):
+        live["running"] = True
+
+        response = _submit(context="Answering: Ada", queued=True)
+
+        assert _code(response) == cc.CONTEXT_BUSY
+        assert not live.get("queued_prompts")
+
+    def test_plain_submit_while_busy_still_queues(self, live, monkeypatch):
+        live["running"] = True
+        seen = []
+        monkeypatch.setattr(server, "_handle_busy_submit", lambda *a, **k: seen.append(a) or {"result": {"status": "queued"}})
+
+        assert _submit(queued=True) == {"result": {"status": "queued"}}
+        assert seen
+
+    @pytest.mark.parametrize("where", ["turn", "session"])
+    def test_isolated_compute_host_turns(self, live, monkeypatch, where):
+        monkeypatch.setattr(server, "_session_uses_compute_host", lambda *a, **k: True)
+        if where == "session":
+            live["client_context"] = "Room: ops"
+
+        response = _submit(**({"context": "Answering: Ada"} if where == "turn" else {}))
+
+        assert _code(response) == cc.CONTEXT_ISOLATED
+
+
+class TestProfilePin:
+    @pytest.fixture
+    def worker_session(self, live, monkeypatch, tmp_path):
+        homes = {"worker": tmp_path / "profiles" / "worker", "writer": tmp_path / "profiles" / "writer"}
+        for home in homes.values():
+            home.mkdir(parents=True)
+        live["profile_home"] = str(homes["worker"])
+        monkeypatch.setattr(server, "_profile_home", lambda name: homes.get(name) or (
+            None if name in ("", "default") else (_ for _ in ()).throw(server.ProfileUnavailableError(name))))
+        monkeypatch.setattr(server, "_current_profile_name", lambda: "default")
+        return live
+
+    def test_another_profile_is_refused_with_the_sessions_own(self, worker_session):
+        response = _submit(profile="writer")
+
+        assert _code(response) == cc.PROFILE_MISMATCH
+        assert response["error"]["data"] == {"session_profile": "worker"}
+        assert "client_surface" not in worker_session
+
+    def test_the_launch_profile_is_another_profile_too(self, worker_session):
+        assert _code(_submit(profile="default")) == cc.PROFILE_MISMATCH
+
+    def test_unknown_profile_stays_4064(self, worker_session):
+        with pytest.raises(server.ProfileUnavailableError):  # handle_request maps it to 4064
+            _submit(profile="ghost")
+
+    def test_own_profile_and_no_profile_pass(self, worker_session, monkeypatch):
+        worker_session["running"] = True
+        monkeypatch.setattr(server, "_handle_busy_submit", lambda *a, **k: {"result": {"status": "queued"}})
+
+        assert _submit(profile="worker", queued=True) == {"result": {"status": "queued"}}
+        assert _submit(queued=True) == {"result": {"status": "queued"}}
+
+    def test_internal_hosted_submits_are_not_pinned(self, worker_session, monkeypatch):
+        monkeypatch.setattr(server, "_hosted_submit_error", lambda *a: {"error": {"code": -1}})
+
+        assert _code(_submit(profile="writer", _hosted_task={"id": "t"})) == -1
+
