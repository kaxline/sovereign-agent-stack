+class TestContracts:
+    @pytest.mark.parametrize("name, params", [
+        ("session.create", {"context": "Room: ops"}),
+        ("session.resume", {"session_id": "s", "context": None}),
+        ("prompt.submit", {"session_id": "s", "text": "hi", "context": "Answering: Ada"}),
+    ])
+    def test_context_is_on_the_wire(self, name, params):
+        _, problem = registry.validate_params(registry.METHODS[name], params)
+
+        assert problem is None
+
