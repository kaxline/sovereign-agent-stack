+def _submit_profile_mismatch_error(rid, session, params):
+    """A session's profile (SOUL, memory, state.db) is fixed at session.create / session.resume. ``profile``
+    on a submit may name that same profile (the desktop's ``requestGatewayForProfile`` adds it to every
+    call) but never another: it used to be accepted and ignored, so a client that meant to address a
+    different agent per turn silently ran the turn on the session's. An unknown name raises
+    ProfileUnavailableError (4064)."""
+    requested = _canonical_profile_request(str(params.get("profile") or "").strip())
+    if not requested:
+        return None
+    from hermes_constants import profile_name_for_home
+    current = profile_name_for_home(session.get("profile_home")) or str(_current_profile_name() or "default")
+    if requested == current:
+        return None
+
+    def _norm(home):
+        return Path(home).resolve() if home else None
+    if _norm(_profile_home(requested)) == _norm(session.get("profile_home")):
+        return None  # another spelling of the same home (launch profile by name, legacy basename)
+    from .client_context import PROFILE_MISMATCH
+    return _err(
+        rid, PROFILE_MISMATCH,
+        f"profile '{requested}' does not match this session's profile '{current}'. A session's profile is "
+        "fixed at session.create / session.resume; open a session on that profile instead.",
+        {"session_profile": current})
+
+
