+"""Client context on the dashboard gateway, and the profile pin on ``prompt.submit``.
+
+A dashboard client knows where a conversation is happening (a room, its members, who is answering)
+and the model should hear it without the user typing it. Two channels, both off the transcript:
+
+* session context (``session.create`` / ``session.resume``) — appended to the ephemeral system
+  prompt, so it is byte-stable across turns and never stored;
+* turn context (``prompt.submit``) — rides ``_gateway_turn_context_notes`` for that turn only.
+
+And a submit may not name a profile other than the session's: it used to be ignored silently.
+"""
+
+from __future__ import annotations
+
+import threading
+import types
+from pathlib import Path
+
+import pytest
+
+from tui_gateway import client_context as cc
+from tui_gateway import server
+from tui_gateway.contracts import registry
+
+
+def _session(**extra):
+    return {
+        "agent": types.SimpleNamespace(valid_tool_names=set(), ephemeral_system_prompt="Be terse."),
+        "session_key": "session-key",
+        "history": [],
+        "history_lock": threading.Lock(),
+        "history_version": 0,
+        "running": False,
+        "transport": None,
+        "attached_images": [],
+        "profile_home": None,
+        **extra,
+    }
+
+
+@pytest.fixture
+def live(monkeypatch):
+    session = _session()
+    server._sessions["sid"] = session
+    monkeypatch.setattr(server, "_session_uses_compute_host", lambda *a, **k: False)
+    yield session
+    server._sessions.pop("sid", None)
+
+
+def _submit(**params):
+    return server._methods["prompt.submit"]("r1", {"session_id": "sid", "text": "hi", **params})
+
+
+def _code(response):
+    return (response.get("error") or {}).get("code")
+
+
+class TestCoerce:
+    def test_null_and_blank_clear(self):
+        assert cc.coerce_context(None) is None
+        assert cc.coerce_context("  \n ") is None
+
+    def test_text_is_stripped(self):
+        assert cc.coerce_context("  Room: ops \n") == "Room: ops"
+
+    @pytest.mark.parametrize("bad", [1, True, ["x"], {"a": 1}, "x" * (cc.MAX_CONTEXT_CHARS + 1)])
+    def test_everything_else_is_refused(self, bad):
+        with pytest.raises(ValueError):
+            cc.coerce_context(bad)
+
+
+class TestSessionContextOnTheSystemPrompt:
+    def test_appended_under_its_heading_with_the_caution(self):
+        agent = types.SimpleNamespace(ephemeral_system_prompt="Be terse.")
+
+        cc.apply_session_context(agent, "Room: ops")
+
+        assert agent.ephemeral_system_prompt.startswith("Be terse.\n\n## Client Session Context")
+        assert cc.CAUTION in agent.ephemeral_system_prompt
+        assert agent.ephemeral_system_prompt.endswith("Room: ops")
+
+    def test_reapplying_is_byte_stable(self):
+        """Every turn re-applies it; the prompt (and so the cache prefix) must not drift."""
+        agent = types.SimpleNamespace(ephemeral_system_prompt="Be terse.")
+        cc.apply_session_context(agent, "Room: ops")
+        first = agent.ephemeral_system_prompt
+
+        cc.apply_session_context(agent, "Room: ops")
+
+        assert agent.ephemeral_system_prompt == first
+
+    def test_change_replaces_rather_than_stacks(self):
+        agent = types.SimpleNamespace(ephemeral_system_prompt="Be terse.")
+        cc.apply_session_context(agent, "Room: ops")
+
+        cc.apply_session_context(agent, "Room: sales")
+
+        assert "ops" not in agent.ephemeral_system_prompt
+        assert agent.ephemeral_system_prompt.count(cc.SESSION_HEADER) == 1
+
+    def test_clearing_restores_the_base(self):
+        agent = types.SimpleNamespace(ephemeral_system_prompt="Be terse.")
+        cc.apply_session_context(agent, "Room: ops")
+
+        cc.apply_session_context(agent, None)
+
+        assert agent.ephemeral_system_prompt == "Be terse."
+
+    def test_a_personality_switch_becomes_the_new_base(self):
+        agent = types.SimpleNamespace(ephemeral_system_prompt="Be terse.")
+        cc.apply_session_context(agent, "Room: ops")
+        agent.ephemeral_system_prompt = "Be a pirate."  # _apply_personality_to_session
+
+        cc.apply_session_context(agent, "Room: ops")
+
+        assert agent.ephemeral_system_prompt.startswith("Be a pirate.\n\n## Client Session Context")
+        assert "Be terse." not in agent.ephemeral_system_prompt
+
+    def test_no_context_never_touches_the_agent(self):
+        agent = types.SimpleNamespace(ephemeral_system_prompt=None)
+
+        cc.apply_session_context(agent, None)
+
+        assert agent.ephemeral_system_prompt is None
+        assert not hasattr(agent, "_client_context_composed")
+
+
+class TestTurnContextNote:
+    def test_joins_notes_already_staged_this_turn(self):
+        agent = types.SimpleNamespace(_gateway_turn_context_notes="[onboarding]")
+
+        cc.stage_turn_context(agent, "Answering: Ada")
+
+        assert agent._gateway_turn_context_notes.startswith("[onboarding]\n\n## Client Turn Context")
+        assert agent._gateway_turn_context_notes.endswith("Answering: Ada")
+
+    def test_nothing_to_stage(self):
+        agent = types.SimpleNamespace()
+
+        cc.stage_turn_context(agent, None)
+
+        assert not hasattr(agent, "_gateway_turn_context_notes")
+
