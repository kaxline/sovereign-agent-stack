# One file per integration that keeps data in the shared `db` Postgres:
#   compose/postgres/services/<slug>.env
# The slug is the schema name and the role suffix (svc_<slug>), so use a plain
# SQL identifier: lowercase letter first, then [a-z0-9_].
#
# Prefer `make db-service-add NAME=<slug>`, which generates the password and
# fills DATABASE_URL. db-provision reads DB_SERVICE_PASSWORD only; the
# integration's own service reads DATABASE_URL (env_file). Both lines hold the
# same secret, so keep this file out of git (*.env is ignored).
DB_SERVICE_PASSWORD=
DATABASE_URL=
