# Credentials for the Actual Budget MCP servers. Copy to budget.env (mode 600)
# and set ACTUAL_BUDGET_FILE=./compose/actual/budget.env in .env. The MCP
# containers read it at /app/.env; it is never passed as environment.
#
# Local server: http://actual-server:5006. Remote: its https:// URL.
ACTUAL_SERVER_URL=http://actual-server:5006
# Where make budget-open goes.
ACTUAL_WEB_URL=http://localhost:5006/
ACTUAL_PASSWORD=
# The budget's Sync ID (groupId in /sync/list-user-files). Always set: without
# it the server opens the first budget it lists.
ACTUAL_BUDGET_SYNC_ID=
# Only for an end-to-end encrypted budget.
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=
