# Hermes browser profile env — copied into the browser profile by bootstrap,
# and read directly by the hermes-webui container to authenticate to it.
# Copy to browser.env and set API_SERVER_KEY (not committed to git).
#
#   cp compose/hermes/browser.env.example compose/hermes/browser.env
#
# Use a key distinct from api-server.env. Hermes scopes keys per profile and
# fails closed when one key is presented to a profile it was not issued for, so
# a shared key is not a shortcut — it is a broken gateway.
#
# The port is not published to the host: only hermes-webui talks to it, over the
# compose network at http://hermes:8644.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8644
API_SERVER_KEY=change-me-generate-with-openssl-rand-hex-32
