# Hermes API profile env — copied into the api-server profile by bootstrap.
# Copy to api-server.env and set API_SERVER_KEY (not committed to git).
#
#   cp compose/hermes/api-server.env.example compose/hermes/api-server.env
#
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8643
API_SERVER_KEY=change-me-generate-with-openssl-rand-hex-32
