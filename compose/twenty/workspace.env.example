# Legacy format. Workspaces now live in <data root>/addons/twenty (see
# docs/crm.md); only ./scripts/crm.sh migrate reads files like this one, from
# compose/twenty/workspaces/<slug>.env, and renames them to .env.migrated.
# Nothing copies this file. Add a workspace with make crm-add or
# scripts/addon.sh connect twenty --instance <slug>.

# Instance URL without /mcp. Local: http://twenty-server:3000
TWENTY_URL=https://crm.example.com
# Where make crm-open sends the browser. Optional.
TWENTY_WORKSPACE_URL=https://crm.example.com/
# API keys, each with a role assigned in Twenty. The read-only key goes to the
# unattended api-server profile; leave it empty to keep the CRM off there.
TWENTY_KEY_RW=
TWENTY_KEY_RO=
