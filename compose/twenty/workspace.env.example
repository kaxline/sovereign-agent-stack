# One Twenty workspace for Hermes. Copy to workspaces/<slug>.env (lowercase
# letters, digits, hyphens); Hermes registers it as mcp_servers.crm-<slug>.
# make crm-init writes these for the local instance; make crm-add for remote ones.
# See docs/crm.md.

# Instance URL without /mcp. Local: http://twenty-server:3000
TWENTY_URL=https://crm.example.com
# Where make crm-open sends the browser. Optional.
TWENTY_WORKSPACE_URL=https://crm.example.com/
# API keys, each with a role assigned in Twenty. The read-only key goes to the
# unattended api-server profile; leave it empty to keep the CRM off there.
TWENTY_KEY_RW=
TWENTY_KEY_RO=
