# CalDAV account for Hermes (one file per account under accounts/).
# Copy to accounts/<slug>.env (e.g. personal.env, work.env), then enable the
# calendar profile and re-run hermes-api-bootstrap / hermes-browser-bootstrap.
#
# Slug = filename without .env → MCP server key caldav-<slug>.
# Use lowercase letters, digits, and hyphens only.

# --- iCloud (default example) ---
# Create an app-specific password: https://support.apple.com/en-us/102654
CALDAV_URL=https://caldav.icloud.com/
CALDAV_USERNAME=you@icloud.com
CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Other providers (replace the three vars above) ---
# Nextcloud:  CALDAV_URL=https://host/remote.php/dav/calendars/user/
# Fastmail:   CALDAV_URL=https://caldav.fastmail.com/dav/calendars/user/
# Radicale:   CALDAV_URL=https://host:5232/user/   (path varies)
