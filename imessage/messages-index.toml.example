# Messages indexer config. Copy to messages-index.toml (gitignored) and fill it in.
# See imessage/README.md. Nothing is indexed until store, since and chats are set.
# Relative paths are relative to this file.

# The folder that holds chat.db: the Messages folder in your Library.
# Left empty on purpose: the indexer has no default.
store = ""

# Where the index is written. Keep it outside the Messages folder.
index = "data/messages/index.sqlite"

# Only messages sent or received on or after this date.
since = 2026-01-01

# Chats to index: ids from the `chats` command, or patterns.
#   "*;-;*"            every 1:1 chat
#   "iMessage;+;*"     every iMessage group
#   "*"                everything (think twice)
chats = []

# Chats to leave out even when a pattern above matches them.
exclude = []

# Optional: the folder holding Contacts' AddressBook-v22.abcddb files (the
# AddressBook folder in your Library's Application Support), to put names on
# phone numbers and addresses. Leave empty to show handles only.
contacts = ""

# List attachment names, types and sizes. Attachment contents are never copied.
attachments = false
# Where attachment files live, if not <store>/Attachments.
# attachments_root = ""

# Longest message body kept, in characters.
max_body_chars = 20000

# The watcher (`watch` command, or the app's LaunchAgent). Defaults shown.
[watch]
# Each wake re-reads messages from this many recent hours, where edits,
# unsends and late chat links happen.
window_hours = 2
# A full pass over the whole scope this often.
full_every_minutes = 60
# Check for changes this often even if no file event arrived.
poll_seconds = 5
debounce_ms = 250
# Where the watcher keeps its cursor. Default: next to the index.
# state = ""

# New-message events. Leave this table out for no events. Events say which
# chat got how many messages from whom, never what they say.
# [notify]
# Which indexed chats raise events (ids or patterns).
# chats = ["iMessage;-;*"]
# A folder that gets one JSON file per event.
# outbox = "data/messages/events"
# Or an HTTP endpoint, signed with HMAC-SHA256 like Hermes' generic webhooks.
# Must be https unless it points at this machine.
# url = "http://127.0.0.1:8650/webhooks/messages"
# secret_file = "data/messages/notify.secret"
# Messages older than this when they're first seen don't raise events.
# max_age_minutes = 10
# Hold events during these local hours and send one per chat afterwards.
# quiet_hours = "22:00-07:00"
