# Local runtime (created by setup). Includes Hermes SOUL.md (per-profile
# personality), USER.md / MEMORY.md, writing-voice samples, curated memory,
# and project working dirs. Never commit this tree — and do not force-add
# SOUL.md or data/voice/<name>/samples/.
data/
# Hermes bind-mount home (also covered by data/ above)
data/hermes/

# Secrets
.env
*.env
compose/hermes/api-server.env
compose/hermes/browser.env
# CalDAV account files (also matched by *.env above)
# compose/caldav-mcp/accounts/<slug>.env
# Regenerated by setup / generate-n8n-credentials.js from .env
n8n/demo-data/credentials/*.json

# Generated local overlays (setup writes secrets / machine toggles here)
searxng/settings.local.yml
opencode/opencode.local.json

# Machine-specific mounts (contains local filesystem paths)
docker-compose.override.yml

# Local model presets (copy from models.yaml.example)
models.local.yaml

# Dev noise
.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/
*.log

# VS Code
.vscode/